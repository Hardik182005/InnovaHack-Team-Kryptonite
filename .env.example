# SafeSpare AI — environment template. Copy to backend/.env and fill in.
#
# IMPORTANT: the application MUST run correctly with every value below left
# blank. With no provider keys it operates in deterministic-template mode:
# all financial calculation, extraction, categorisation, recurrence detection,
# Safe Spare, round-ups and projections are pure Python and need no network.
# Providers only ever rephrase values the backend has already computed.

# --- AI providers (all optional) -------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_FALLBACK_MODEL=

GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_FALLBACK_MODEL=

GROQ_API_KEY=
GROQ_MODEL=
GROQ_FALLBACK_MODEL=

# Text-to-speech only. Never used to generate financial content.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# --- local models -----------------------------------------------------------
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- application ------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=false
DEMO_MODE=true
CORS_ALLOW_ORIGINS=http://localhost:5173
RATE_LIMIT_REQUESTS=240
RATE_LIMIT_WINDOW_SECONDS=60
MAX_UPLOAD_BYTES=15728640
UPLOAD_URL_TTL_SECONDS=900

# --- AWS (deployment only) --------------------------------------------------
AWS_REGION=ap-south-1
S3_UPLOAD_BUCKET=
DYNAMODB_TABLE_PREFIX=safespare
SSM_PARAMETER_PREFIX=/safespare

# --- frontend (VITE_ vars are PUBLIC — never put a secret here) -------------
VITE_API_BASE_URL=http://localhost:8000
VITE_DATA_MODE=auto

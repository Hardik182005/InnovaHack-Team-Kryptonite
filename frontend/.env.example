# SafeSpare AI — frontend environment.
#
# NOTHING SECRET GOES IN THIS FILE. Vite inlines every VITE_* variable into the
# JavaScript bundle, so an LLM / ElevenLabs / AWS key placed here would ship to
# every browser. Spec §3.16 and §29.17 forbid it. All provider credentials live
# in the backend only.

# Base URL for the API. Leave blank to use same-origin + the Vite dev proxy.
VITE_API_BASE_URL=

# Data source: "auto" | "live" | "fixtures"
#   auto     — try the live API, fall back to bundled fixtures with a visible banner
#   live     — live API only; failures surface as retry states
#   fixtures — never call the network; always use the bundled demo fixtures
VITE_DATA_MODE=auto

# Milliseconds before a request is treated as failed.
VITE_API_TIMEOUT_MS=15000

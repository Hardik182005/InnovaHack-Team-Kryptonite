# Baked into the bundle at build time by Vite.
#
# Without this, API_BASE_URL resolves to '' and every fetch goes to the
# CloudFront origin, which only serves the static S3 site -- so /api/* returns
# the SPA's index.html, the client sees a non-JSON response, and the app looks
# like it simply has no analysis. infra/scripts/deploy.sh passes the same value
# on the command line; this file is what keeps a plain `npm run build` from
# silently shipping a frontend that cannot reach the backend.
VITE_API_BASE_URL=https://100-48-40-252.sslip.io
VITE_DATA_MODE=auto
VITE_API_TIMEOUT_MS=15000
